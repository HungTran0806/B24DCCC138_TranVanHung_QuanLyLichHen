<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout  android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Heading" android:text="Thêm lịch hẹn"/><LinearLayout  android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" style="@style/Card" android:layout_marginBottom="12dp">
<EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/title" android:hint="Tên lịch hẹn" android:inputType="textCapSentences" android:maxLines="1"/><EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/location" android:hint="Địa điểm" android:inputType="textCapSentences" android:maxLines="1"/>
</LinearLayout><LinearLayout  android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" style="@style/Card" android:layout_marginBottom="12dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ngày hẹn"/><DatePicker android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/date" android:datePickerMode="spinner" android:calendarViewShown="false"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Giờ hẹn"/><TimePicker android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/time" android:timePickerMode="spinner"/><Switch android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:id="@+id/reminder" android:text="Nhắc nhở"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/error" android:text="" android:textColor="#B3261E" android:visibility="gone"/>
</LinearLayout><Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/save" android:text="Lưu lịch hẹn" style="@style/PrimaryButton"/>
</LinearLayout>
</ScrollView>
